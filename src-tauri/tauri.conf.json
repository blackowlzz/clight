{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clight",
  "version": "0.1.13",
  "identifier": "dev.blackowlzz.clight",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "clight",
        "width": 1180,
        "height": 740,
        "minWidth": 640,
        "minHeight": 400,
        "center": true,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "C/C++ IDE for very low-end machines",
    "icon": [
      "icons/icon.png",
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2M0ExN0RBNzBGN0NDNTYKUldSV3pQZHcyaGM2Umh1LzVUZm1XKzVwRDZBbkU4bFI2WnpUWDdJdy83c2t2Z1BNV1lGaTZaQXAK",
      "endpoints": [
        "https://github.com/blackowlzz/clight/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
